# DNS A record for this subdomain must point at the VPS before the first deploy.
API_DOMAIN=api.example.com
HOME_DOMAIN=home.example.com
PUBLIC_BASE_URL=https://api.example.com
PORT=3000
# Name of the existing external Docker network used by Traefik. Used only by docker-compose.traefik.yml.
TRAEFIK_NETWORK=proxy

# Generate once: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# Legacy single-home TV token. Imported once as a device of the migrated home, then unused.
# Leave empty on a fresh install; every TV gets its own token through the pairing code.
DEVICE_TOKEN=

# Create a NEW OAuth client of type Web application after API_DOMAIN is known.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only when another local service shares this exact Google redirect URI: callbacks that are
# not ours are handed to this URL instead of being rejected. Leave empty otherwise.
OAUTH_FORWARD_URL=

# Telegram: create via @BotFather. Anyone may talk to the bot; each person only sees their own homes.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
# Only for importing a pre-multi-home installation: these IDs become owners of the imported home.
# Empty on a fresh install. Adding IDs afterwards grants no access.
TELEGRAM_ALLOWED_USER_IDS=
# true: any Telegram user can create their own home. false: only invitations into existing homes.
REGISTRATION_OPEN=true
# Capacity of this server. When it is reached, sign-ups get 503 and existing homes keep working.
MAX_HOUSEHOLDS=100
MINI_APP_ORIGIN=https://home.example.com
TELEGRAM_WEB_APP_URL=https://home.example.com/console/

# Experimental D-pad / application launch remote. Music metadata and screen settings still work.
TV_REMOTE_ENABLED=false
# Keep empty unless all traffic arrives through a known proxy subnet. Never use 0.0.0.0/0.
TRUST_PROXY=
# Calendar labels of the imported home only. Every other home names its calendars in the app.
PERSON_1_NAME="Участник 1"
PERSON_2_NAME="Участник 2"
