{
  "name": "dino-tv-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test dist/*.test.js",
    "quality": "npm run check && npm run lint && npm test"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "googleapis": "^178.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "eslint": "^9.36.0",
    "tsx": "^4.19.3",
    "typescript-eslint": "^8.44.1",
    "typescript": "^5.7.3"
  }
}
